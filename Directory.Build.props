<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Nexus Software Labs</Company>
    <Authors>Nexus Software Labs</Authors>
    <Copyright>Nexus Software Labs</Copyright>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/ncosentino/NexusLabs.Framework</RepositoryUrl>

    <!--
      Lockstep versioning: every NexusLabs.* package in this repo ships at this
      version on every release. Bump this single value to release a new version
      of the entire monorepo; the release workflow packs + pushes every package
      at the same version.
    -->
    <Version>0.2.6</Version>
  </PropertyGroup>

  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ncosentino/NexusLabs.Framework</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="IDisposableAnalyzers" PrivateAssets="all" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(MSBuildProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <!--
    Dog-food NexusLabs.Framework.Analyzers across every project in the
    repo. Three projects are excluded because they cannot or should not
    receive the analyzer via this central path:

      - NexusLabs.Framework.Analyzers: self-reference, circular.
      - NexusLabs.Framework.Analyzers.CodeFixes: the Analyzers project
        already references CodeFixes, so a reverse ProjectReference here
        would create a cycle.
      - NexusLabs.Framework.Analyzers.Tests: keeps its own explicit pair
        with ReferenceOutputAssembly="true" for Analyzers AND CodeFixes
        because the tests instantiate analyzer/codefix types directly.

    Unlike IDisposableAnalyzers (non-test only above), this analyzer is
    wired into BOTH production and test projects so all NLF rules cover
    test code too.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'NexusLabs.Framework.Analyzers'
                    And '$(MSBuildProjectName)' != 'NexusLabs.Framework.Analyzers.CodeFixes'
                    And '$(MSBuildProjectName)' != 'NexusLabs.Framework.Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/NexusLabs.Framework.Analyzers/NexusLabs.Framework.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
