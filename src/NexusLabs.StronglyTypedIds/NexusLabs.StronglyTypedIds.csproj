<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>UUIDv7 creation support for Guid-backed strongly typed identifiers. Adds an opt-in template, TimeProvider-aware factories, dependency-injection registration, and bundled analyzer guidance without replacing generated parsing, formatting, equality, or converter behavior.</Description>
    <PackageReleaseNotes>See https://github.com/ncosentino/NexusLabs.Framework/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The integration intentionally pins the only available 1.x generator release exactly. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="StronglyTypedId" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusLabs.StronglyTypedIds.Analyzers\NexusLabs.StronglyTypedIds.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\NexusLabs.StronglyTypedIds.Analyzers.CodeFixes\NexusLabs.StronglyTypedIds.Analyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NexusLabs.StronglyTypedIds.targets"
          Pack="true"
          PackagePath="build"
          Visible="false" />
    <None Include="Templates\*.typedid"
          Pack="true"
          PackagePath="build\AdditionalFiles"
          Visible="false" />
    <None Include="..\NexusLabs.StronglyTypedIds.Analyzers\bin\$(Configuration)\netstandard2.0\NexusLabs.StronglyTypedIds.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers\dotnet\cs\netstandard2.0"
          Visible="false" />
    <None Include="..\NexusLabs.StronglyTypedIds.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\NexusLabs.StronglyTypedIds.Analyzers.CodeFixes.dll"
          Pack="true"
          PackagePath="analyzers\dotnet\cs\netstandard2.0"
          Visible="false" />
  </ItemGroup>

</Project>
