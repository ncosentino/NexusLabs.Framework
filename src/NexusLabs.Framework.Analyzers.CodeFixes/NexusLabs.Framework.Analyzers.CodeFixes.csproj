<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Code fixes paired with NexusLabs.Framework.Analyzers diagnostics. The compiled dll is packed into the NexusLabs.Framework.Analyzers nupkg under analyzers/dotnet/cs/ — this project does not produce its own nupkg.</Description>

    <!--
      RS1038 forbids DiagnosticAnalyzer classes from living in an assembly that
      references Microsoft.CodeAnalysis.Workspaces. CodeFixProvider classes
      require Workspaces (CodeAction, Document, FixAllProvider, etc.), so the
      analyzers and code fixes must live in separate assemblies. This project
      holds only CodeFixProvider classes; the Analyzers project packs the
      compiled output of this project into its nupkg so consumers install a
      single package.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
